{
  "rewrites": [
    {
      "source": "/api/osm/query",
      "destination": "https://overpass-api.de/api/interpreter"
    },
    {
      "source": "/api/osm/fallback",
      "destination": "https://overpass.kumi.systems/api/interpreter"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
